<?xml version="1.0" encoding="utf-8"?>
<!-- API anahtarları cihazın donanım anahtar deposuyla şifreli; o anahtar başka
     cihaza taşınamadığı için yedekten dönen kayıt zaten çözülemez. Sohbetler de
     buluta gitmesin diye hiçbir şey yedeklenmiyor. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
